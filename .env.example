OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MAIN_MODEL=openai/gpt-5.6-sol
OPENROUTER_BROWSER_MODEL=openai/gpt-5.6-sol

# Select the CEO provider explicitly; no silent provider substitution.
ARC_CEO_PROVIDER=google_ai_studio
# For openrouter, set ARC_CEO_PROVIDER=openrouter and an exact model ID.
ARC_CEO_MODEL=
ARC_CEO_MAX_OUTPUT_TOKENS=1024
ARC_AGENT_MAX_OUTPUT_TOKENS=4096
# Google AI Studio is the default CEO provider.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_CEO_MODEL=gemini-3.8-flash

ARC_FINANCE_MODEL=openai/gpt-5.6-sol
ARC_MARKETING_MODEL=openai/gpt-5.6-sol
ARC_IT_MODEL=openai/gpt-5.6-sol
ARC_LEGAL_MODEL=openai/gpt-5.6-sol
ARC_MANAGER_MODEL=openai/gpt-5.6-sol

# Optional access restriction for a private server/proxy. Do not embed in Flutter.
# Leave empty for guest sessions on your trusted network.
ARC_BACKEND_API_KEY=

# Tool workspace only; chat, permissions and approvals are kept in RAM.
ARC_AGENT_WORKSPACE_ROOT=

# Optional connector gateways. Keep them blank until a trusted HTTPS gateway
# is deployed. Connector operations still require a one-time user approval.
ARC_FINANCE_CONNECTOR_URL=
ARC_FINANCE_CONNECTOR_TOKEN=
ARC_CRM_CONNECTOR_URL=
ARC_CRM_CONNECTOR_TOKEN=
ARC_CLOUD_CONNECTOR_URL=
ARC_CLOUD_CONNECTOR_TOKEN=
ARC_REMOTE_COMPUTER_URL=
ARC_REMOTE_COMPUTER_TOKEN=
# GitHub OAuth + GitHub App connection.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/github/callback
GITHUB_PRIVATE_KEY_PATH=
# Alternative to GITHUB_PRIVATE_KEY_PATH for secret-manager deployment only.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Comma-separated browser origins. Leave blank for native/mobile-only clients.
ARC_ALLOWED_ORIGINS=
# In production, set the exact public host plus local development hosts.
ARC_TRUSTED_HOSTS=
ARC_AUTH_RATE_LIMIT_PER_MINUTE=600
ARC_AGENT_RUNS_PER_MINUTE=30
ARC_BROWSER_HEADLESS=true
# Optional exact private hosts for local development only (for example 10.0.2.2).
ARC_BROWSER_PRIVATE_HOST_ALLOWLIST=

# Legacy persona assignments use these exact model IDs, never a fallback model.
# The full model catalog uses OPENROUTER_API_KEY and the selected exact model ID.
# Leave blank to show an agent as unconfigured. Set the matching model slug
# available to your provider account (for example anthropic/claude-sonnet-4.6).
# OPENROUTER_API_KEY is also required. GPT Sol is the marketplace display name.
ARC_MARKET_GPT_SOL_MODEL=
ARC_MARKET_CLAUDE_MODEL=
ARC_MARKET_GEMINI_MODEL=
ARC_MARKET_DEEPSEEK_MODEL=
ARC_MARKET_QWEN_MODEL=
ARC_MARKET_MISTRAL_MODEL=
ARC_MARKET_LLAMA_MODEL=
ARC_MARKET_GROK_MODEL=

# Security: guest access is loopback-only in development. Azure/production
# requires a strong backend key injected by an authenticated gateway, never Flutter.
ARC_ENVIRONMENT=development
# Terminal execution is delegated to an isolated, credential-free worker.
# Backend approval alone never grants this worker access to the API host.
ARC_TERMINAL_RUNNER_URL=
ARC_TERMINAL_RUNNER_TOKEN=
# Local setup provisions one workspace using a one-time connection code.
ARC_TERMINAL_GRANTS_FILE=
# Explicitly provision trusted session actor IDs for all managed gateways.
# Keep empty to deny gateway execution. Values are guest:<sha256(session UUID)>.
ARC_CONNECTOR_ALLOWED_ACTORS=

# Continuous company work; local launcher enables this automatically.
ARC_COMPANY_WORKER_ENABLED=1
# Empty uses .arc/company.sqlite3 under the server working directory.
ARC_COMPANY_DB=

# Repository selected by the installation; publishing stays on arc/work-* branches.
ARC_GITHUB_REPOSITORY=owner/repository
