FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHON_DOTENV_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends docker.io && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY lib/backend/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r /app/requirements.lock
COPY lib/backend/terminal_policy.py /app/lib/backend/terminal_policy.py
COPY services/terminal_gateway.py /app/services/terminal_gateway.py
CMD ["python", "/app/services/terminal_gateway.py", "--port", "8768"]
